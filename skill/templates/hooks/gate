#!/usr/bin/env bash
# PreToolUse(Bash): refuse git push / gh pr create until the branch's work note is current (spec D2, D7).
set -uo pipefail
[ "${SCAFFOLD_HEADLESS:-}" = 1 ] && exit 0  # unattended refresh sessions must not get brief/gate behaviour
input=$(cat)
cmd=$(jq -r '.tool_input.command // empty' <<<"$input" 2>/dev/null) || exit 0
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh" 2>/dev/null || exit 0
# Runs before every Bash call: nothing before this check may spawn git.
is_push_cmd "$cmd" || exit 0
[ "${SCAFFOLD_SKIP:-}" = 1 ] && exit 0
grep -qE '(^|[;&| ])SCAFFOLD_SKIP=1 ' <<<"$(_norm_cmd "$cmd")" && exit 0
dir=$(jq -r '.cwd // empty' <<<"$input"); dir=$(target_dir "$cmd" "${dir:-$PWD}")
root=$(scaffold_root "$dir") || exit 0
top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || exit 0  # ls-tree/show/diff pathspecs are cwd-relative
load_config "$root" || exit 0
branch=$(git -C "$dir" branch --show-current 2>/dev/null) || exit 0
if [ -z "$branch" ] || [ "$branch" = "$BASE_BRANCH" ]; then exit 0; fi
b=$(safe_text <<<"$branch")

deny() {
  jq -n --arg r "scaffold gate: $1" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
  exit 0
}
nonote="no work note lists branch $b. Create $SC/work/active/<task>.md whose first lines are status:, branch: $b, waiting-on:, next:, then retry."

if [ "$SCAFFOLD_MODE" = shared ]; then
  # The PR carries the committed copy: discover and validate from HEAD, never the working tree.
  rel=$(committed_note_for_branch "$top" "$branch") || exit 0  # git failed: no decision
  if [ -z "$rel" ]; then
    wt=$(notes_for_branch "$branch" | head -1)
    [ -n "$wt" ] || deny "$nonote"
    deny "$(safe_text <<<"${wt#"$root"/}") is not committed on $b. Commit it with the change, then retry."
  fi
  r=$(safe_text <<<"$rel")
  committed=$(mktemp) || exit 0
  trap 'rm -f "$committed"' EXIT
  git -C "$top" show "HEAD:$rel" >"$committed" 2>/dev/null || exit 0
  headers_complete "$committed" || deny "the committed copy of $r has an incomplete header. Commit the fixed header, then retry."
  changed=$(git -C "$top" diff --name-only "$REMOTE/$BASE_BRANCH...HEAD" -- "$rel" 2>/dev/null) || exit 0
  [ -n "$changed" ] || deny "$r is not changed on this branch. Update its header for this push, commit it with the change, then retry."
else
  note=$(notes_for_branch "$branch" | head -1)
  [ -n "$note" ] || deny "$nonote"
  headers_complete "$note" || deny "$(safe_text <<<"${note#"$root"/}") header is incomplete: fill status:, branch:, waiting-on:, next:, then retry."
  # Notes are untracked here: freshness is judged per command kind against the last allowed run.
  # A stamp holds the HEAD of the last allowed run: a retry of the same commit (blocked or failed push) passes.
  kinds=$(cmd_kinds "$cmd")
  s=$(tr / _ <<<"$branch")
  head=$(git -C "$top" rev-parse HEAD 2>/dev/null) || head=""
  for k in $kinds; do
    [ "$note" -nt "$STATE/$k-$s" ] || { [ -n "$head" ] && [ "$(cat "$STATE/$k-$s" 2>/dev/null)" = "$head" ]; } || deny "$(safe_text <<<"${note#"$root"/}") not updated since the last $k of $b. Update status:/waiting-on:/next:, then retry."
  done
  mkdir -p "$STATE" && for k in $kinds; do echo "$head" >"$STATE/$k-$s"; done
fi
exit 0
