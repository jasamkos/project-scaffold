# Scaffold hook settings, sourced by .scaffold/hooks/lib.sh.
SCAFFOLD_MODE=local
BASE_BRANCH=main
REMOTE=origin
# claude.ai artifact URL of the status board; empty = no board.
BOARD_URL=
